{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "esnext"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "@commands/*": [
        "./src/commands/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@contexts/*": [
        "./src/contexts/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@types_/*": [
        "./src/types/*"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ]
    }
  }
}