# Local development settings
# Copy this file to .env for local development:
#   cp .env.example .env

# Port for the webpack dev server (required for manual testing).
# The webpack dev server reads PORT from this file (via dotenv), but
# `make dev`'s wait-on readiness check reads PORT from the shell
# (defaulting to 8080), not this file. So to change the port, export
# PORT in your shell so both agree, rather than only editing this file.
PORT=8080
