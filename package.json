{
  "name": "nightvision",
  "displayName": "NightVision",
  "publisher": "nvsecurity",
  "description": "Test and exploit REST APIs and Web apps from your IDE.",
  "version": "1.0.9",
  "license": "Apache-2.0",
  "icon": "docs/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nvsecurity/nightvision-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/nvsecurity/nightvision-vscode/issues"
  },
  "keywords": [
    "pentesting",
    "security",
    "application-security",
    "dast",
    "static analysis"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nightvision-sidebar-view",
          "title": "NightVision",
          "icon": "media/nightvision.svg"
        }
      ]
    },
    "views": {
      "nightvision-sidebar-view": [
        {
          "type": "webview",
          "id": "nightvision-sidebar",
          "name": "NightVision",
          "icon": "media/nightvision.svg",
          "contextualTitle": "NightVision"
        }
      ]
    },
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "npm-run-all --parallel watch:*",
    "watch:ext": "webpack --mode development --watch --config ./webpack/extension.config.js",
    "watch:wv": "webpack serve --mode development --config ./webpack/webview.config.js",
    "dev": "concurrently -k -s command-ide --names watch,ide \"npm run watch\" \"npm run dev:ide\"",
    "dev:ide": "wait-on dist/extension.js http-get://localhost:${PORT:-8080}/webview.js && code --extensionDevelopmentPath=$PWD --new-window --wait",
    "package": "npm run clean && npm-run-all --parallel package:*",
    "package:ext": "webpack --mode production --config ./webpack/extension.config.js",
    "package:wv": "webpack --mode production --config ./webpack/webview.config.js",
    "compile-tests": "rimraf out && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run package && npm run lint",
    "lint": "eslint . --max-warnings 0",
    "clean": "rimraf dist",
    "test": "node ./out/test/runTest.js",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.7.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.71.0",
    "@types/vscode-webview": "^1.57.5",
    "@types/webpack": "^5.28.1",
    "@types/webpack-dev-server": "^4.7.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-electron": "^3.1.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "css-loader": "^6.7.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.2",
    "glob": "^8.0.3",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-loader": "^7.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "rimraf": "^3.0.2",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.4.3",
    "ts-loader": "^9.4.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.7.4",
    "uuid": "^14.0.2",
    "wait-on": "^9.0.10",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "react-syntax-highlighter": "^16.1.0",
    "sudo-prompt": "^9.2.1",
    "tar": "^7.5.16",
    "use-debounce": "^10.0.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
